# FasalSethu backend — copy to .env and fill in (never commit real secrets).
# Server
PORT=8000
NODE_ENV=development

# PostgreSQL connection string used by Prisma.
# Example local: postgresql://postgres:postgres@localhost:5432/fasalsethu?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/fasalsethu?schema=public"

# Allowed frontend origins (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Auth0 JWT authentication (RS256). Deal/notification APIs require a valid
# Bearer token; B1/B2 farmer/crop/buyer/market reads stay public.
# No defaults are provided on purpose — without these, protected routes fail
# closed with 503. Never commit real tenant values.
# AUTH0_ISSUER_BASE_URL=https://TENANT.us.auth0.com/
# AUTH0_AUDIENCE=fasalsethu-api

# Explicit JWKS document URL (optional). When unset, the verifier derives
# <AUTH0_ISSUER_BASE_URL>/.well-known/jwks.json exactly as before. Applies to
# the primary issuer only; other trusted issuers always use the derived path.
# The URL is read from configuration only — never from a request or token.
# AUTH0_JWKS_URI=https://TENANT.us.auth0.com/.well-known/jwks.json

# Additional trusted issuers, comma-separated (optional). When set, this list
# REPLACES the single-issuer behaviour. Every entry is matched exactly and
# verified with RS256 against the same AUTH0_AUDIENCE — there is no wildcard
# and no prefix matching. A malformed entry stops the process at boot rather
# than being ignored.
# AUTH_TRUSTED_ISSUERS=https://TENANT.us.auth0.com/

# First-party RS256 signing material. The public half is published at
# GET /.well-known/jwks.json; the private half is never returned by any API and
# is never logged. The API starts fine without these — the JWKS endpoint and any
# future token minting then fail with a clear 503 rather than falling back to an
# ephemeral key. Once set, AUTH_PRIVATE_KEY must be a PKCS#8 RSA PEM (2048 bits
# or stronger); a single-line value with escaped \n is accepted. Supply the PEM
# through the platform's secret store only — never commit a private key, client
# secret, token or password to this file.
# AUTH_PRIVATE_KEY=
# AUTH_KEY_ID=

# Token lifetimes (positive integers; defaults shown).
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_DAYS=30

# Credential lockout policy (positive integers; defaults shown). Bounded by
# design: on reaching the threshold the account locks for the window and the
# counter resets, so an attacker can never lock a user out permanently. Neither
# value is ever reported to the caller — every failed login returns the same
# generic 401.
# AUTH_LOCKOUT_MAX_ATTEMPTS=5
# AUTH_LOCKOUT_DURATION_MINUTES=15

# Rate limiting for the auth endpoints (positive integers; defaults shown).
# Two SEPARATE budgets, so refresh/logout traffic can never exhaust the sign-in
# allowance. Counters are held in this process's memory: they reset when the
# instance restarts and are NOT shared between instances, so the effective limit
# multiplies by the instance count if the service is ever scaled horizontally.
# NOTE: many users behind one carrier-grade NAT share a public address, so raise
# AUTH_CREDENTIAL_RATE_LIMIT_MAX if legitimate sign-ins are being throttled; the
# per-account lockout above remains the precise control.
# AUTH_CREDENTIAL_RATE_LIMIT_MAX=20
# AUTH_TOKEN_RATE_LIMIT_MAX=60
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# How many reverse proxies to trust when deriving the client address used as the
# rate-limit key. Render sits behind exactly one proxy that appends the real
# client address to X-Forwarded-For, so trusting a single hop reads the entry
# the proxy wrote and cannot be spoofed by a client. Without this every request
# would appear to come from the proxy and share one global counter.
# Accepts a hop count (0, 1, 2) or true/false. Do NOT set true unless nothing
# but your proxy can reach the service.
# TRUST_PROXY=1

# Production notes (Render/cloud — values come from the platform, never this file):
# - Set PORT from the platform (it injects its own; the app defaults to 8000 locally).
# - Set NODE_ENV=production (hides error stacks from API responses).
# - Set DATABASE_URL to the managed PostgreSQL URL, e.g.
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
#   then run `npm run db:deploy` once against it (never `migrate dev` / reset).
# - Set CORS_ORIGIN to the deployed frontend origin(s),
#   e.g. CORS_ORIGIN=https://<github-user>.github.io
