# AgriBridge API Environment Configuration Template
# Copy this file to .env and adjust VITE_API_BASE_URL for your local or production backend.
#
# VITE_API_BASE_URL: base URL of the FasalSethu backend, WITHOUT a trailing slash.
#   - Local:  http://localhost:8000/api
#   - Deployed: https://fasalsethu.onrender.com/api
# Leave empty to run entirely on local mock data (no backend calls at all).
# The production URL is deliberately NOT hardcoded in any component: it is read
# from this variable only, so the same build can target any environment.
VITE_API_BASE_URL=http://localhost:8000/api

# Fallback to local mock data when the backend is unreachable (true/false).
# This only affects MARKETPLACE read APIs, never authentication: a failed
# /api/auth/* call is always surfaced to the user and never replaced with mock
# data. Set to false once the backend endpoints used by the app are deployed.
VITE_ENABLE_MOCK_FALLBACK=true

# Google Maps JavaScript API key, used by the buyer-location map features
# (GoogleMapBuyerRadar, NearbyMapInterface, BuyerMatchMap). Supply your own key
# locally and through the deployment platform's secret store. The value below is
# a placeholder, not a working key.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Note: authentication requires a real backend. Register through
# /farmer-register or /buyer-register; the returned credentials are then used to
# sign in at /login/farmer or /login/buyer. No secrets belong in this file.
