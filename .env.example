# AgriBridge API Environment Configuration Template
# Copy this file to .env and adjust VITE_API_BASE_URL for your local or production backend.

VITE_API_BASE_URL=http://localhost:8000/api
VITE_ENABLE_MOCK_FALLBACK=true

# Auth0 Configuration
VITE_AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
# Optional API Audience if backend validates Auth0 JWT tokens
VITE_AUTH0_AUDIENCE=
